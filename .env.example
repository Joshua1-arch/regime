# Bitget API Configuration
# Generate a Demo (Paper Trading) API Key in your Bitget Account settings
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_API_URL=https://api.bitget.com

# Alibaba Qwen (DashScope) API Configuration
# Get your API key from Alibaba Cloud DashScope console
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Dune Analytics API Configuration
# Get your API key from the Dune Analytics settings console
DUNE_API_KEY=your_dune_api_key_here
# Optional: Query ID to test (defaulting to 2030664 for stablecoin flows)
DUNE_QUERY_ID=2030664
