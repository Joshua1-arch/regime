# Bitget API Configuration
# Generate a Demo (Paper Trading) API Key in your Bitget Account settings
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here
BITGET_API_URL=https://api.bitget.com

# Alibaba Qwen (DashScope) API Configuration
# Get your API key from Alibaba Cloud DashScope console
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Dune Analytics API Configuration
# Get your API key from the Dune Analytics settings console
DUNE_API_KEY=your_dune_api_key_here
# Optional: Query ID to test (defaulting to 2030664 for stablecoin flows)
DUNE_QUERY_ID=2030664

# Solana Execution Configuration (Optional fallback: system will generate a fresh keypair on boot if not set)
# Format: JSON array of 64 bytes numbers representing the secret key, e.g. [123,45,67...]
SOLANA_PRIVATE_KEY=your_solana_private_key_array_here
# Optional: Devnet/Mainnet RPC URL (defaults to https://api.devnet.solana.com)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Frontend Dashboard Configuration
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
DEMO_MODE=true

# Cloud Database Configuration (Optional. Falls back to local state.json if not set)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=your_mongodb_connection_string_here
